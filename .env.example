NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-role key. Server-side only. Used to provision staff users.
# Get it from Supabase project settings -> API -> service_role.
# Never commit this and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key

# Google Workspace SMTP — used to send magic-link emails.
# SMTP_USER:     your Google Workspace address (e.g. support@arit.co.in)
# SMTP_PASSWORD: an App Password generated at myaccount.google.com
#                (Account → Security → 2-Step Verification → App passwords)
SMTP_USER=support@arit.co.in
SMTP_PASSWORD=your_app_password_here
